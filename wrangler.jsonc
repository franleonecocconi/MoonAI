{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",

  "name": "moonai-worker",
    
  "main": "src/index.js",

  "compatibility_date": "2026-05-03",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "directory": "../public"
  },

  "ai": {
    "binding": "AI",
    "remote": true
  }
}